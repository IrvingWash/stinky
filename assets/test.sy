-- println 3 * 2^2

age := 17
age := age + 1

println "The value of global variable 'age' is " + age

println "Checking the age:"
if age >= 18 then
    is_cool := true
    println "Adult (" + age + ")"
else
    -- This should error because is_cool was declared in a different scope
    println "Youngster (" + age + ") and is ~" + is_cool + " cool"
    age := age - 1
end

println "age is now " + age
